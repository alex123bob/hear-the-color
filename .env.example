# Backend base URL (no trailing slash).
# Local dev: leave empty, requests go through the Vite proxy -> http://localhost:8000
# Production: VITE_API_BASE_URL=https://lijialab.com
VITE_API_BASE_URL=

# Optional: backend address used by the local proxy (default http://localhost:8000)
# DEV_PROXY_TARGET=http://localhost:8000
